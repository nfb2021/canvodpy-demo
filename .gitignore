# macOS metadata
.DS_Store

# Python bytecode
__pycache__/
*.pyc
*.pyo

# Runtime caches
*.db

# Marimo session state (runtime only — do NOT ignore assets/, thumbnails live there)
__marimo__/session/

# Pipeline outputs (stores, aux caches)
outputs/

# canvodpy logging output (created when running notebooks that import canvodpy)
.logs/

# Test data (cloned separately for standalone use)
test_data/

# Legacy data directory (use test_data instead)
data/
.coverage
*.lcov
